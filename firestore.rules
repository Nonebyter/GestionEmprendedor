rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catalogo: lo lee cualquiera, solo el admin autenticado lo modifica.
    match /products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Pedidos: el cliente puede crearlos y consultarlos sin login.
    // Solo el admin autenticado puede cambiar el estado o borrarlos.
    match /orders/{id} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Datos internos del negocio: solo el admin.
    match /purchases/{id} {
      allow read, write: if request.auth != null;
    }
    match /sales/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
